{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 22",
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "commonjs",
    "target": "ES2023",
    "moduleResolution": "Node",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "outDir": "./build/",
    "rootDir": "./src",
    "baseUrl": "./",
    "declaration": true,

    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.ts",
    "src/test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
